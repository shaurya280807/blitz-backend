# Application
NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/blitz
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/blitz?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=24h

# Admin Provisioning (used by seed:admin script only)
ADMIN_USERNAME=blitz_admin
ADMIN_PASSWORD=replace-with-strong-password

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# Uploads directory (relative to project root)
UPLOADS_DIR=uploads
